# ClickHouse local : base et utilisateur créés au démarrage Docker.
# Les clients Docker utilisent toujours clickhouse:8123 (HTTP).
CLICKHOUSE_DATABASE=streamloom
CLICKHOUSE_USER=streamloom

# make up / make superset / make connect génèrent les secrets absents dans .env :
# CLICKHOUSE_PASSWORD, SUPERSET_SECRET_KEY, SUPERSET_DB_PASSWORD,
# SUPERSET_ADMIN_PASSWORD. Garder .env avec les volumes persistants.
SUPERSET_ADMIN_USERNAME=admin
