# Connexion ClickHouse Cloud, nécessaire uniquement pour le stockage et Superset.
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-me

# make superset génère automatiquement les trois secrets absents dans .env :
# SUPERSET_SECRET_KEY, SUPERSET_DB_PASSWORD et SUPERSET_ADMIN_PASSWORD.
# Conserver ces valeurs pour retrouver les dashboards et les connexions.
SUPERSET_ADMIN_USERNAME=admin
